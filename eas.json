{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20"
    },
    "preview": {
      "distribution": "internal",
      "node": "20",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "20",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
